{
  "provider": {
    "name": "finlab-openldap",
    "providerId": "ldap",
    "providerType": "org.keycloak.storage.UserStorageProvider",
    "config": {
      "enabled": [
        "true"
      ],
      "priority": [
        "0"
      ],
      "vendor": [
        "other"
      ],
      "connectionUrl": [
        "ldap://ldap:389"
      ],
      "authType": [
        "simple"
      ],
      "bindDn": [
        "cn=keycloak,ou=services,dc=finlab,dc=com"
      ],
      "usersDn": [
        "ou=users,dc=finlab,dc=com"
      ],
      "usernameLDAPAttribute": [
        "uid"
      ],
      "rdnLDAPAttribute": [
        "uid"
      ],
      "uuidLDAPAttribute": [
        "entryUUID"
      ],
      "userObjectClasses": [
        "inetOrgPerson"
      ],
      "searchScope": [
        "2"
      ],
      "editMode": [
        "READ_ONLY"
      ],
      "importEnabled": [
        "true"
      ],
      "syncRegistrations": [
        "false"
      ],
      "cachePolicy": [
        "NO_CACHE"
      ],
      "fullSyncPeriod": [
        "-1"
      ],
      "changedSyncPeriod": [
        "-1"
      ],
      "pagination": [
        "true"
      ],
      "batchSizeForSync": [
        "100"
      ],
      "connectionPooling": [
        "false"
      ],
      "connectionTimeout": [
        "5000"
      ],
      "readTimeout": [
        "5000"
      ],
      "startTls": [
        "false"
      ],
      "useTruststoreSpi": [
        "always"
      ],
      "trustEmail": [
        "false"
      ],
      "validatePasswordPolicy": [
        "false"
      ]
    }
  },
  "groupMapper": {
    "name": "finlab-ldap-groups",
    "providerId": "group-ldap-mapper",
    "providerType": "org.keycloak.storage.ldap.mappers.LDAPStorageMapper",
    "config": {
      "groups.dn": [
        "ou=groups,dc=finlab,dc=com"
      ],
      "groups.path": [
        "/ldap"
      ],
      "group.name.ldap.attribute": [
        "cn"
      ],
      "group.object.classes": [
        "groupOfNames"
      ],
      "membership.ldap.attribute": [
        "member"
      ],
      "membership.attribute.type": [
        "DN"
      ],
      "membership.user.ldap.attribute": [
        "uid"
      ],
      "mode": [
        "READ_ONLY"
      ],
      "user.roles.retrieve.strategy": [
        "LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"
      ],
      "preserve.group.inheritance": [
        "false"
      ],
      "ignore.missing.groups": [
        "false"
      ],
      "drop.non.existing.groups.during.sync": [
        "false"
      ]
    }
  },
  "groupRoles": {
    "developers": {
      "finaccess-api": [
        "user"
      ],
      "finadmin-api": [
        "user"
      ],
      "finlegacy-api": [
        "reader"
      ]
    },
    "approvers": {
      "finaccess-api": [
        "approver"
      ],
      "finadmin-api": [
        "user"
      ],
      "finlegacy-api": [
        "reader"
      ]
    },
    "admins": {
      "finaccess-api": [
        "user",
        "approver",
        "admin"
      ],
      "finadmin-api": [
        "admin"
      ],
      "finlegacy-api": [
        "admin"
      ]
    }
  }
}
